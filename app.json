{
  "expo": {
    "name": "MadriListo",
    "slug": "madrilisto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "madrilisto",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.dalechang.madrilisto",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "dev.dalechang.madrilisto",
      "adaptiveIcon": {
        "backgroundColor": "#E5484D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "locales": {
      "es": "./assets/native-locales/es.json",
      "en": "./assets/native-locales/en.json"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["es", "en"],
            "android": ["es", "en"]
          },
          "supportsRTL": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MadriListo usa tu ubicación para mostrarte los recursos públicos más cercanos.",
          "locationWhenInUsePermission": "MadriListo usa tu ubicación para mostrarte los recursos públicos más cercanos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E5484D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
